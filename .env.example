# SERVER ONLY: set in Render's environment. Never prefix this with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
# Web/PWA uses its own server origin automatically.
# APK builds only: public URL of the deployed EggPro server, no credentials.
# VITE_API_URL=https://eggpro.onrender.com
# Legacy offline developer mode; never enable in cloud builds.
VITE_LOCAL_ONLY=false
