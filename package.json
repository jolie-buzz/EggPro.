{
  "name": "farmtrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.html docs README.md",
    "check": "npm test && npm run build && npm run test:e2e",
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/share": "^7.0.0",
    "@supabase/supabase-js": "^2.109.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
